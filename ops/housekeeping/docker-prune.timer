# ops/housekeeping/docker-prune.timer → /etc/systemd/system/docker-prune.timer
[Unit]
Description=Weekly Docker prune

[Timer]
# Sunday 05:00, an hour after the nightly backup. Persistent so a reboot across
# the window still runs it.
OnCalendar=Sun *-*-* 05:00:00
Persistent=true

[Install]
WantedBy=timers.target

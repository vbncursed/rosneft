# Empty on purpose, mirroring frontend/.env.development. Vite proxies /api to
# the gateway (vite.config.ts), so the SPA is single-origin with the API in
# dev exactly as it is meant to be in prod. Without this file VITE_API_URL is
# `undefined`, and every request in shared/api/client.ts goes to
# "undefined/api/...".
VITE_API_URL=

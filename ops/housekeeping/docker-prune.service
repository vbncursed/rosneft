# ops/housekeeping/docker-prune.service → /etc/systemd/system/docker-prune.service
#
# Every `docker compose build` leaves build cache and superseded images behind;
# by 2026-10-01 they held 63 GB of a 119 GB disk. Both commands remove only what
# nothing uses: the build cache, and images no container (running or stopped)
# references and that are older than a week (the last week's images stay as a
# rollback). Volumes — the data — are never touched.
[Unit]
Description=Prune unused Docker build cache and images
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/docker builder prune -a -f
ExecStart=/usr/bin/docker image prune -a -f --filter until=168h

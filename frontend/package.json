{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "tsc -b --noEmit && oxlint --type-aware && yarn fmt:check",
    "fmt": "oxfmt src build vite.config.ts exempt-modules.ts",
    "fmt:check": "oxfmt --check src build vite.config.ts exempt-modules.ts",
    "openapi:generate": "openapi-typescript ../backend/services/gateway-service/api/openapi.yaml -o src/shared/api/dto.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cosmos": "cosmos",
    "cosmos:export": "cosmos-export",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@github/webauthn-json": "^2.1.1",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "@tanstack/react-query": "5.104.0",
    "@tanstack/react-router": "1.170.41",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "qrcode.react": "^4.2.0",
    "react": "~19.3.0",
    "react-dom": "~19.3.0",
    "three": "0.186.1",
    "three-mesh-bvh": "0.9.15",
    "three-stdlib": "2.36.1"
  },
  "devDependencies": {
    "@react-three/test-renderer": "9.1.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.0",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "jsdom": "^30.1.1",
    "openapi-typescript": "7.13.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "react-cosmos": "^7.4.1",
    "react-cosmos-plugin-vite": "^7.4.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "resolutions": {
    "openapi-typescript/typescript": "5.9.3"
  }
}

{
  "name": "andrey-desktop",
  "productName": "Andrey",
  "version": "0.4.0",
  "description": "Desktop client for the Andrey 3D viewer",
  "homepage": "https://andrey.vbncursed.fun",
  "author": {
    "name": "vbncursed",
    "email": "vbncursed@users.noreply.github.com"
  },
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build:ts": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint --type-aware src",
    "fmt": "oxfmt src vitest.config.mts",
    "fmt:check": "oxfmt --check src vitest.config.mts",
    "test": "vitest run",
    "dev": "yarn build:ts && electron .",
    "dist": "yarn build:ts && electron-builder --publish never"
  },
  "devDependencies": {
    "@electron/osx-sign": "1.3.3",
    "@types/node": "^24.19.2",
    "electron": "44.9.0",
    "electron-builder": "26.17.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "7.0.2",
    "vite": "^8.3.4",
    "vitest": "5.0.5"
  },
  "packageManager": "yarn@4.18.1"
}
